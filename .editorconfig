# EditorConfig: https://editorconfig.org
# Baseline editor settings matching the Oilmod1 code style.
# Copy this file to the root of your project to apply it there as well.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Java and XML deviate from the 2-space default, as in the Oilmod1 IntelliJ scheme
[*.{java,xml}]
indent_size = 4
# IntelliJ-specific
ij_continuation_indent_size = 8

[*.java]
max_line_length = 160

[*.md]
# two trailing spaces are used as hard line breaks in markdown
trim_trailing_whitespace = false

# make requires tabs for recipe indentation
[{Makefile,makefile,GNUmakefile,*.mk}]
indent_style = tab

# other languages follow their own style guides, as in the Oilmod1 IntelliJ scheme
# Google Python style (4 spaces, 80 characters)
[*.py]
indent_size = 4
max_line_length = 80

# Google JavaScript style and protobuf style guide
[*.{js,mjs,cjs,proto}]
max_line_length = 80

# Google Objective-C style
[*.{m,mm}]
max_line_length = 100

# repository-specific: checkstyle sample that must stay without a final newline, omit when copying this file
[java/checkstyle/verify/src/invalid/java/sample/MissingNewline.java]
insert_final_newline = false
