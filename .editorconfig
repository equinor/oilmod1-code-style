# EditorConfig: https://editorconfig.org
# Baseline editor settings matching the Oilmod1 code style.
# Copy this file to the root of your project to apply it there as well.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.java]
max_line_length = 160
# IntelliJ-specific: continuation indent of 8, as in the Oilmod1 IntelliJ scheme
ij_continuation_indent_size = 8

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# two trailing spaces are used as hard line breaks in markdown
trim_trailing_whitespace = false
